# Configuration locale pour le développement
# Copiez ce fichier vers .env.local et configurez vos valeurs

# Base de données locale
DATABASE_URL="postgresql://feedplug:feedplug123@localhost:5432/feedplug?schema=public"

# Redis local
REDIS_URL="redis://localhost:6379"

# JWT (clés de développement - À CHANGER EN PRODUCTION)
JWT_SECRET="dev-jwt-secret-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="dev-refresh-secret-change-in-production"
JWT_REFRESH_EXPIRES_IN="30d"

# Application
NODE_ENV="development"
PORT=3000
API_PREFIX="api/v1"
CORS_ORIGIN="http://localhost:3000"

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Google Cloud (optionnel pour le développement local)
GOOGLE_CLOUD_PROJECT_ID="your-gcp-project-id"
GOOGLE_CLOUD_STORAGE_BUCKET="feedplug-storage-dev"
GOOGLE_CLOUD_PUBSUB_TOPIC="feedplug-jobs-dev"

# Pennylane (clés de test)
PENNYLANE_API_URL="https://api.pennylane.com/v2"
PENNYLANE_API_KEY="your-pennylane-test-api-key"
PENNYLANE_WEBHOOK_SECRET="your-pennylane-webhook-secret"

# IA APIs (optionnel)
GEMINI_API_KEY="your-gemini-api-key"
MISTRAL_API_KEY="your-mistral-api-key"

# Connecteurs plateformes (clés de test)
GOOGLE_MERCHANT_ID="your-google-merchant-id"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"

AMAZON_CLIENT_ID="your-amazon-client-id"
AMAZON_CLIENT_SECRET="your-amazon-client-secret"
AMAZON_REFRESH_TOKEN="your-amazon-refresh-token"

MIRAKL_API_URL="https://api.mirakl.com"
MIRAKL_API_KEY="your-mirakl-api-key"

# Monitoring (optionnel)
SENTRY_DSN="your-sentry-dsn"
SLACK_WEBHOOK_URL="your-slack-webhook-url"

# Cloudflare Turnstile (anti-spam signup)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

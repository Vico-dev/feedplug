# ===== BASE DE DONNÉES =====
DATABASE_URL="postgresql://username:password@localhost:5432/feedplug?schema=public"

# ===== REDIS =====
REDIS_URL="redis://localhost:6379"

# ===== JWT =====
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="30d"

# ===== GOOGLE CLOUD =====
GOOGLE_CLOUD_PROJECT_ID="your-gcp-project-id"
GOOGLE_CLOUD_STORAGE_BUCKET="feedplug-storage"
GOOGLE_CLOUD_PUBSUB_TOPIC="feedplug-jobs"

# ===== PENNYLANE API =====
PENNYLANE_API_URL="https://api.pennylane.com/v2"
PENNYLANE_API_KEY="your-pennylane-api-key"
PENNYLANE_WEBHOOK_SECRET="your-pennylane-webhook-secret"

# ===== IA APIs =====
GEMINI_API_KEY="your-gemini-api-key"
MISTRAL_API_KEY="your-mistral-api-key"

# ===== CONNECTEURS PLATEFORMES =====
# Google Merchant Center
GOOGLE_MERCHANT_ID="your-google-merchant-id"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Meta (Facebook)
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"

# Amazon SP-API
AMAZON_CLIENT_ID="your-amazon-client-id"
AMAZON_CLIENT_SECRET="your-amazon-client-secret"
AMAZON_REFRESH_TOKEN="your-amazon-refresh-token"

# Mirakl
MIRAKL_API_URL="https://api.mirakl.com"
MIRAKL_API_KEY="your-mirakl-api-key"

# ===== APPLICATION =====
NODE_ENV="development"
PORT=3000
API_PREFIX="api/v1"

# ===== CORS =====
CORS_ORIGIN="http://localhost:3000"

# ===== RATE LIMITING =====
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ===== MONITORING =====
SENTRY_DSN="your-sentry-dsn"
SLACK_WEBHOOK_URL="your-slack-webhook-url"

# ===== FRONTEND (build / runtime — préfixe NEXT_PUBLIC_) =====
NEXT_PUBLIC_API_URL="https://your-backend.run.app/api/v1"
NEXT_PUBLIC_SITE_URL="https://app.feedplug.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
NEXT_PUBLIC_SENTRY_DSN=""

# ===== BACKEND MARKETING / PROD =====
APP_URL="https://app.feedplug.com"
API_URL="https://api.feedplug.com"
# SMTP (forgot-password, emails transactionnels)
SMTP_HOST=""
SMTP_USER=""
SMTP_PASS=""
SMTP_PORT="587"
SMTP_SECURE="false"
EMAIL_FROM="FeedPlug <noreply@feedplug.com>"
MARKETING_REPLY_TO="hello@feedplug.com"
RESEND_API_KEY=""
RESEND_AUDIENCE_ID=""
MARKETING_UNSUBSCRIBE_SECRET=""
# Stripe (facturation)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PROFESSIONAL=""
STRIPE_PRICE_ENTERPRISE=""
# Google OAuth (GMC)
GOOGLE_REDIRECT_URI="https://your-backend.run.app/api/v1/platforms/gmc/callback"
# Amazon SP-API
AMAZON_LWA_CLIENT_ID=""
AMAZON_LWA_CLIENT_SECRET=""
AMAZON_APPLICATION_ID=""
AMAZON_REDIRECT_URI=""
AMAZON_LOGIN_URI=""
AMAZON_SELLER_CENTRAL_BASE="https://sellercentral.amazon.fr"
AMAZON_SP_API_BASE="https://sellingpartnerapi-eu.amazon.com"
# Shopify — OAuth
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
# Scopes : doivent matcher shopify.app.toml (source de vérité Partners)
SHOPIFY_SCOPES="read_analytics,read_channels,read_inventory,read_orders,read_product_feeds,read_product_listings,read_products"
SHOPIFY_CALLBACK_URL="https://api.feedplug.com/api/v1/connectors/shopify/callback"
# Version de l'Admin API utilisée par les modules ingestion/billing/provisioning
SHOPIFY_ADMIN_API_VERSION="2026-01"

# Shopify — Billing API (BFS-required pour les apps payantes via App Store)
# Base URL publique pour construire le returnUrl Shopify Billing.
# En prod : "https://api.feedplug.com" (le backend Cloud Run).
API_PUBLIC_URL=""
# Trial days par défaut accordés à la souscription (Shopify Billing).
SHOPIFY_BILLING_TRIAL_DAYS="0"
# Taux de conversion EUR → devise cible si la devise du shop n'est pas EUR.
# Par défaut : SHOPIFY_BILLING_EUR_USD_RATE=1.08 (fallback USD).
SHOPIFY_BILLING_EUR_USD_RATE="1.08"
# Optionnel : forcer test mode sur la subscription même en prod (sandbox)
# SHOPIFY_BILLING_FORCE_TEST="false"

# Shopify — Auto-provisioning Account
# Durée du trial (jours) accordé à un Account auto-créé lors d'un install App Store.
SHOPIFY_PROVISION_TRIAL_DAYS="14"
# Staff / admin (optionnel)
FEEDPLUG_STAFF_EMAILS="admin@feedplug.com"
FEEDPLUG_STAFF_ACCOUNT_IDS="default-account"
# Cloudflare Turnstile (anti-spam signup)
TURNSTILE_SECRET_KEY=""
# Scheduler / Cloud Scheduler (optionnel)
SCHEDULER_SECRET=""
# Garde-fous schéma prod: laisser "false" sauf opération contrôlée.
ENABLE_RUNTIME_SCHEMA_MIGRATIONS="false"
ENABLE_SCHEMA_REPAIR_ENDPOINTS="false"
# Chiffrement applicatif des tokens OAuth / credentials en base.
# Utiliser une valeur dédiée en production; fallback possible sur JWT_SECRET pour rétrocompatibilité.
SECRET_ENCRYPTION_KEY=""
# IA / images (optionnel)
FAL_KEY=""
GOOGLE_CLOUD_LOCATION=""
GOOGLE_CLOUD_LOCATION_IMAGE=""
LIFESTYLE_IMAGE_PROVIDER="vertex"
LIFESTYLE_VERTEX_MODEL="gemini-2.5-flash-image"
GRACEFUL_SHUTDOWN_TIMEOUT_MS="30000"
